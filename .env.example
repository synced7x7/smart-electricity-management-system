# Copy this file to .env and adjust values for your local machine.
# .env is git-ignored — never commit real secrets.

# Postgres (shared instance for all services at this skeleton stage)
POSTGRES_DB=descodb
POSTGRES_USER=desco
POSTGRES_PASSWORD=desco_local_password
POSTGRES_PORT=5432

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION_MS=3600000

# Service ports
CONFIG_SERVER_PORT=8888
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
OUTAGE_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084
COMPLAINT_SERVICE_PORT=8085
PAYMENT_SERVICE_PORT=8086
ADMIN_SERVICE_PORT=8087
