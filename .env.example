# =============================================================================
# DESCO Simulation — Local Developer Overrides
# =============================================================================
# Copy this file to .env and customize values for your local machine.
# .env is listed in .gitignore and must NEVER be committed.
#
# Only set the variables you actually need to override; compose defaults
# (the :-xxxx fallbacks in docker-compose.yml) apply for everything else.
# =============================================================================

# --- PostgreSQL ---
# POSTGRES_DB=desco
# POSTGRES_USER=desco
# POSTGRES_PASSWORD=desco_local_password
# POSTGRES_PORT=5432

# --- Config Server ---
# CONFIG_SERVER_PORT=8888

# --- API Gateway ---
# API_GATEWAY_PORT=8080        # Override if 8080 is occupied (e.g. set to 8090)

# --- Backend Services ---
# AUTH_SERVICE_PORT=8081
# USER_SERVICE_PORT=8082
# OUTAGE_SERVICE_PORT=8083
# NOTIFICATION_SERVICE_PORT=8084
# COMPLAINT_SERVICE_PORT=8085
# PAYMENT_SERVICE_PORT=8086
# ADMIN_SERVICE_PORT=8087

# --- JWT ---
# JWT_SECRET=change-me-to-a-long-random-string
# JWT_EXPIRATION_MS=3600000
