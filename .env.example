# Copy to .env and fill in real values. .env is gitignored; this file is not,
# so it must never contain a working credential.

# --- Database (Supabase) ---------------------------------------------------
DB_URL=jdbc:postgresql://<host>:<port>/postgres
DB_USERNAME=<supabase-user>
DB_PASSWORD=<supabase-password>
DB_PORT=5432

# --- JWT -------------------------------------------------------------------
# Must be at least 256 bits for HS256. The committed fallback in each
# application.yml is for local development only and must never be deployed.
JWT_SECRET=<at-least-32-random-characters>
JWT_ACCESS_TOKEN_EXPIRATION=900000      # 15 min
JWT_REFRESH_TOKEN_EXPIRATION=604800000  # 7 days

# --- Admin registration ----------------------------------------------------
# Supplying this key to POST /api/auth/register creates an ADMIN account
# instead of a USER. It is the only remote path to ADMIN in the system.
#
#   * Leave it BLANK or omit it to disable admin self-registration entirely.
#   * Minimum 16 characters, or the server refuses to honour it.
#   * Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#   * Rotate it if it ever leaks; existing admins are unaffected by a rotation.
ADMIN_REGISTRATION_KEY=
