# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.iml
.claude

# Java / Maven
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# Node / Frontend
node_modules/
dist/
.vite/
npm-debug.log*

# Env
.env
.env.local

# Docker
*.pid

# Local documentation — working notes kept out of the repo on purpose.
# These patterns have no slash, so they match at any depth (including
# frontend/), which is also where frontend/.gitignore lists the last two.
DOCUMENTATION_BACKEND.md
DOCUMENTATION_FRONTEND.md
FRONTEND_SKILL.md
.logs/
frontend/DOCUMENTATION_FRONTEND.md

# db/ is local-only by default (dumps, scratch SQL, anything with credentials),
# but migrations and the generator MUST ship — a migration nobody else can pull
# is not a migration. Note the pattern excludes the directory *contents*, not
# the directory: git cannot re-include a file inside an excluded directory.
/db/*

# Test scripts stay local. Anything that is part of running or shipping the
# system must be rescued by name — a blanket *.sh silently drops new scripts,
# which is exactly what happened when run-local.sh was renamed to deploy.sh.
*.sh
!deploy.sh
